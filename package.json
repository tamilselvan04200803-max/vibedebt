{
  "name": "vibedebt",
  "version": "0.1.0",
  "description": "Safety net for AI refactors: freeze behavior with generated tests, extract clean modules from vibe-coded JS/TS, auto-rollback on any failure",
  "license": "MIT",
  "homepage": "https://github.com/tamilselvan04200803-max/vibedebt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tamilselvan04200803-max/vibedebt.git"
  },
  "bugs": {
    "url": "https://github.com/tamilselvan04200803-max/vibedebt/issues"
  },
  "keywords": [
    "refactoring",
    "ai-coding",
    "vibe-coding",
    "code-quality",
    "technical-debt",
    "typescript",
    "ast",
    "ts-morph",
    "characterization-tests",
    "rollback",
    "static-analysis",
    "cli"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "bin": {
    "vibedebt": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "bin",
    "assets/mermaid.min.js",
    "assets/mermaid.LICENSE",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc -p tsconfig.build.json",
    "demo": "node scripts/demo.js",
    "start": "node scripts/serve-dashboard.js",
    "serve": "node scripts/serve-dashboard.js",
    "vibedebt:map": "npm run build --silent && node dist/cli/index.js map",
    "vibedebt:anchor": "npm run build --silent && node dist/cli/index.js anchor",
    "vibedebt:heal": "npm run build --silent && node dist/cli/index.js heal",
    "vibedebt:run": "npm run build --silent && node dist/cli/index.js run",
    "test": "vitest run",
    "fixture:reset": "node scripts/reset-fixture.js",
    "benchmark:realworld": "npm run build --silent && node scripts/realworld-acceptance.mjs"
  },
  "dependencies": {
    "@playwright/test": "1.65.1",
    "commander": "^13.1.0",
    "ts-morph": "^25.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "typescript": "^5.8.2",
    "vitest": "^5.1.0"
  }
}
